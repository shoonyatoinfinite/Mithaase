# ==============================================================================
# Mithaasé — Shree Shyam Sweets Environment Variables Template
# Copy this file to .env.local and populate with your own credentials:
# cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL Database & Auth
# Get your connection string from https://console.neon.tech
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production

# Neon Auth Configuration (OAuth / Social Auth / BetterAuth)
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=your-random-32-character-secret-key-here

# ------------------------------------------------------------------------------
# 2. Email OTP Delivery (SMTP - Brevo / Gmail / SendGrid / Amazon SES)
# Used for one-time verification codes during customer email registration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-key
SMTP_FROM="Shree Shyam Sweets <no-reply@mithaase.in>"

# ------------------------------------------------------------------------------
# 3. Store Merchant & UPI Payment Details
# Displayed to customers for QR code generation & direct UPI intent
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_UPI_ID=shreeshyam@upi
NEXT_PUBLIC_STORE_UPI_NAME="Shree Shyam Sweets"

# Optional Payment Gateway (Razorpay / Cashfree)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 4. Store Administration Fallback Passcode
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY=admin2026
